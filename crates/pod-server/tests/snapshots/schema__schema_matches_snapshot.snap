column session.user_id uuid not null
column session.device_id uuid not null
column session.device_name text not null
column session.created_at timestamp with time zone not null default now()
column session.last_seen timestamp with time zone not null default now()
column session.expires_at timestamp with time zone not null
column sonos_session.player_id text not null
column sonos_session.user_id uuid not null
column sonos_session.episode_id uuid not null
column sonos_session.audio_url text not null
