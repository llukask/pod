column applied_mutation.user_id uuid not null
column applied_mutation.mutation_id uuid not null
column applied_mutation.result jsonb not null
column applied_mutation.applied_at timestamp with time zone not null default now()
column episode.id uuid not null
column episode.podcast_id uuid not null
column episode.guid text not null
column episode.title text not null
column episode.summary_html text not null default ''::text
column episode.content_html text not null default ''::text
column episode.link text
column episode.published_at timestamp with time zone not null
column episode.duration_ms bigint
column episode.audio_url text not null
column episode.audio_type text not null
column episode.audio_bytes bigint
column episode.artwork_url text
column episode.season integer
column episode.number integer
column episode.content_hash bytea not null
column episode.deleted boolean not null default false
column episode.version bigint not null
column episode.created_at timestamp with time zone not null default now()
column episode.updated_at timestamp with time zone not null default now()
column episode_state.user_id uuid not null
column episode_state.episode_id uuid not null
column episode_state.podcast_id uuid not null
column episode_state.position_ms bigint not null default 0
column episode_state.position_at timestamp with time zone
column episode_state.position_dev uuid
column episode_state.played boolean not null default false
column episode_state.played_at timestamp with time zone
column episode_state.played_dev uuid
column episode_state.archived boolean not null default false
column episode_state.archived_at timestamp with time zone
column episode_state.archived_dev uuid
column episode_state.version bigint not null
