column feed_poll.etag text
column feed_poll.last_modified text
column feed_poll.content_hash bytea
column feed_poll.next_poll_at timestamp with time zone not null default now()
column feed_poll.consecutive_errors integer not null default 0
column feed_poll.last_polled_at timestamp with time zone
column feed_poll.first_error_at timestamp with time zone
column podcast.id uuid not null
column podcast.feed_url text not null
column podcast.status text not null default 'pending'::text
column podcast.title text
column podcast.author text
column podcast.description text
column podcast.link text
column podcast.artwork_url text
column podcast.language text
column podcast.metadata_hash bytea
column podcast.version bigint not null
column podcast.version_counter bigint not null default 0
column podcast.created_at timestamp with time zone not null default now()
column podcast.updated_at timestamp with time zone not null default now()
column podcast.failing_since timestamp with time zone
column podcast.feed_error jsonb
column podcast_alias.normalized_url text not null
column podcast_alias.podcast_id uuid not null
