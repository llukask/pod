constraint applied_mutation.applied_mutation_pkey PRIMARY KEY (user_id, mutation_id)
constraint episode.episode_pkey PRIMARY KEY (id)
constraint episode.episode_podcast_id_fkey FOREIGN KEY (podcast_id) REFERENCES podcast(id)
constraint episode.episode_podcast_id_guid_key UNIQUE (podcast_id, guid)
constraint episode_state.episode_state_episode_id_fkey FOREIGN KEY (episode_id) REFERENCES episode(id)
constraint episode_state.episode_state_pkey PRIMARY KEY (user_id, episode_id)
constraint episode_state.episode_state_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
constraint feed_poll.feed_poll_pkey PRIMARY KEY (podcast_id)
constraint feed_poll.feed_poll_podcast_id_fkey FOREIGN KEY (podcast_id) REFERENCES podcast(id)
constraint podcast.podcast_failing_carries_reason CHECK (((status = 'failing'::text) = ((failing_since IS NOT NULL) AND (feed_error IS NOT NULL))))
constraint podcast.podcast_pkey PRIMARY KEY (id)
constraint podcast.podcast_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'ok'::text, 'failing'::text, 'gone'::text])))
constraint podcast_alias.podcast_alias_pkey PRIMARY KEY (normalized_url)
constraint podcast_alias.podcast_alias_podcast_id_fkey FOREIGN KEY (podcast_id) REFERENCES podcast(id)
constraint session.session_device_id_key UNIQUE (device_id)
constraint session.session_pkey PRIMARY KEY (token_hash)
constraint session.session_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
constraint sonos_session.sonos_session_pkey PRIMARY KEY (player_id)
constraint sonos_session.sonos_session_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
constraint subscription.subscription_pkey PRIMARY KEY (user_id, podcast_id)
constraint subscription.subscription_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
constraint user_setting.user_setting_pkey PRIMARY KEY (user_id, key)
constraint user_setting.user_setting_user_id_fkey FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
constraint users.users_pkey PRIMARY KEY (id)
constraint users.users_username_key UNIQUE (username)
index applied_mutation CREATE INDEX applied_mutation_applied_at_idx ON public.applied_mutation USING btree (applied_at)
index applied_mutation CREATE UNIQUE INDEX applied_mutation_pkey ON public.applied_mutation USING btree (user_id, mutation_id)
index episode CREATE UNIQUE INDEX episode_pkey ON public.episode USING btree (id)
index episode CREATE UNIQUE INDEX episode_podcast_id_guid_key ON public.episode USING btree (podcast_id, guid)
index episode CREATE INDEX episode_podcast_id_published_at_idx ON public.episode USING btree (podcast_id, published_at DESC)
index episode CREATE INDEX episode_podcast_id_version_idx ON public.episode USING btree (podcast_id, version)
index episode_state CREATE UNIQUE INDEX episode_state_pkey ON public.episode_state USING btree (user_id, episode_id)
index episode_state CREATE INDEX episode_state_user_id_version_idx ON public.episode_state USING btree (user_id, version)
index feed_poll CREATE INDEX feed_poll_next_poll_at_idx ON public.feed_poll USING btree (next_poll_at)
index feed_poll CREATE UNIQUE INDEX feed_poll_pkey ON public.feed_poll USING btree (podcast_id)
index podcast CREATE UNIQUE INDEX podcast_pkey ON public.podcast USING btree (id)
index podcast_alias CREATE UNIQUE INDEX podcast_alias_pkey ON public.podcast_alias USING btree (normalized_url)
index session CREATE UNIQUE INDEX session_device_id_key ON public.session USING btree (device_id)
index session CREATE UNIQUE INDEX session_pkey ON public.session USING btree (token_hash)
index sonos_session CREATE UNIQUE INDEX sonos_session_pkey ON public.sonos_session USING btree (player_id)
index subscription CREATE UNIQUE INDEX subscription_pkey ON public.subscription USING btree (user_id, podcast_id)
index subscription CREATE INDEX subscription_user_id_version_idx ON public.subscription USING btree (user_id, version)
index user_setting CREATE UNIQUE INDEX user_setting_pkey ON public.user_setting USING btree (user_id, key)
index user_setting CREATE INDEX user_setting_user_id_version_idx ON public.user_setting USING btree (user_id, version)
index users CREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)
index users CREATE UNIQUE INDEX users_username_key ON public.users USING btree (username)
