  "query": "select u.id, u.username, u.created_at as \"created_at: SqlTimestamp\",\n                  count(s.token_hash) filter (where s.expires_at > $1) as \"sessions!\"\n           from users u left join session s on s.user_id = u.id\n           group by u.id\n           order by u.username",
